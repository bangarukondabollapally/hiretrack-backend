# Backend Environment Variables
#
# Copy this file to .env and fill in real values for local development.
# .env is gitignored — never commit real credentials.
#
# TASK-001: No database variables needed yet — DataSource is excluded.
# TASK-002 will add DB credentials here.

# --- Added in TASK-002 ---
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=hiretrack
# DB_USERNAME=your_db_user
# DB_PASSWORD=your_db_password

# --- Added in TASK-007 ---
# JWT_SECRET=your-minimum-256-bit-secret-key
# JWT_EXPIRATION_MS=86400000

# --- Added in TASK-027 ---
# GROQ_API_KEY=your_groq_api_key
# GROQ_MODEL=llama3-8b-8192
