# Backend Environment Variables
#
# Copy this file to .env and fill in real values for local development.
# .env is gitignored — never commit real credentials.

# ── Database ──────────────────────────────────────────────────────────────────
# Example: DB_HOST=localhost, DB_PORT=3307, DB_NAME=hiretrack, DB_SSL_MODE=DISABLED (local/Docker) or REQUIRED (Aiven)
DB_HOST=localhost
DB_PORT=3307
DB_NAME=hiretrack
DB_SSL_MODE=your_db_ssl_mode_here
DB_USERNAME=your_db_username_here
DB_PASSWORD=your_db_password_here
MYSQL_ROOT_PASSWORD=your_mysql_root_password_here

# ── Frontend & CORS ───────────────────────────────────────────────────────────
# Example: FRONTEND_URL=https://hiretrack.vercel.app
FRONTEND_URL=your_frontend_url_here

# ── JWT Security ──────────────────────────────────────────────────────────────
# Example: 256-bit base64 secret key
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION_MS=86400000

# ── Groq AI ───────────────────────────────────────────────────────────────────
# Example: gsk_... or model name like openai/gpt-oss-120b
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=your_groq_model_name_here

# ── Admin Provisioning ────────────────────────────────────────────────────────
# Example: ADMIN_EMAIL=admin@hiretrack.local, ADMIN_PASSWORD=admin123456
ADMIN_EMAIL=your_admin_email_here
ADMIN_PASSWORD=your_admin_password_here


