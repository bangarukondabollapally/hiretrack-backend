# Backend Environment Variables
#
# Copy this file to .env and fill in real values for local development.
# .env is gitignored — never commit real credentials.

# ── Database (required from TASK-002 onward) ─────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hiretrack
DB_USERNAME=hiretrack_app
DB_PASSWORD=hiretrack@2026

# ── JWT (added in TASK-007) ───────────────────────────────────────────────────
# JWT_SECRET=your-minimum-256-bit-secret-key-change-this
# JWT_EXPIRATION_MS=86400000

# ── Groq AI (added in TASK-027) ──────────────────────────────────────────────
# GROQ_API_KEY=your_groq_api_key
# GROQ_MODEL=llama3-8b-8192
